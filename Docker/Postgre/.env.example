# Copia este archivo a .env y rellena los valores. .env NO se versiona.

# --- Base de datos ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=rellenar
POSTGRES_DB=cooksmart

# --- API ---
# Secreto para firmar los JWT. GENERA UNO PROPIO Y SECRETO, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Nunca lo subas al repo ni lo reutilices entre entornos (control C1, M7).
JWT_SECRET=rellenar-con-un-valor-aleatorio-largo

# Token para exponer GET /metrics (observabilidad, M7).
# Si lo dejas vacío, /metrics NO se expone (responde 404). Genéralo igual que el JWT_SECRET.
METRICS_TOKEN=

# Límite de intentos fallidos de login por (IP, correo) (control C2, M7). on por defecto.
LOGIN_RATELIMIT=on

# Log JSON por petición (observabilidad, M7). on por defecto; off reduce volumen
# de logs sin perder las métricas de /metrics ni la cabecera X-Request-Id.
LOG_PETICIONES=on
